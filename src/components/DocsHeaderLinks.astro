---
import { DEMO_URL, DOCKER_HUB_URL } from '../site';
---

<nav class="docs-links" aria-label="QuizDock">
  <a href="/">Home</a>
  <a href="/deploy/">Deploy</a>
  <a href={DEMO_URL} target="_blank" rel="noopener">Demo ↗</a>
  <a href={DOCKER_HUB_URL} target="_blank" rel="noopener">Docker Hub ↗</a>
</nav>

<style>
  .docs-links {
    display: flex;
    gap: 1rem;
    font-size: var(--sl-text-sm);
    white-space: nowrap;
  }
  .docs-links a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .docs-links a:hover {
    color: var(--sl-color-white);
  }
  @media (max-width: 50rem) {
    .docs-links a:not(:last-child) {
      display: none;
    }
  }
</style>
