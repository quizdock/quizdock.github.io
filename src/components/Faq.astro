---
/**
 * A page's questions: each one a direct answer (HTML), shown folded, and given
 * to search engines and assistants as a schema.org FAQPage.
 */
interface Props {
  items: { q: string; a: string }[];
  title?: string;
}
const { items, title = 'Questions' } = Astro.props;
const text = (html: string) => html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: text(i.a) },
  })),
};
---

<section class="section faq" id="questions">
  <h2>{title}</h2>
  {
    items.map((i) => (
      <details>
        <summary>{i.q}</summary>
        <div set:html={i.a} />
      </details>
    ))
  }
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</section>
