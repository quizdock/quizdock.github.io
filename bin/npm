#!/bin/sh
# npm in a container (only Docker on the host): ./bin/npm install, ./bin/npm run dev.
# QUIZDOCK_DATA_DIR=../quiz-dock builds from a quiz-dock checkout instead of the latest release.
cd "$(dirname "$0")/.." || exit 1
if [ -t 0 ] && [ -t 1 ]; then tty=-it; else tty=; fi
data=
[ -n "${QUIZDOCK_DATA_DIR:-}" ] && data="-v $(cd "$QUIZDOCK_DATA_DIR" && pwd):/data:ro -e QUIZDOCK_DATA_DIR=/data"
# shellcheck disable=SC2086
exec docker run --rm $tty -e ASTRO_TELEMETRY_DISABLED=1 -v "$PWD":/site -w /site -p 4321:4321 $data node:24 npm "$@"
